---
import { SITE } from '../config/site';
const updated = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: 'Asia/Seoul' });
---
<footer class="site-footer">
  <div class="wrap row">
    <p>© {new Date().getFullYear()} {SITE.name} · Last updated {updated}</p>
    <p><a href="/privacy/">Privacy</a> · Theme adapted from <a href="https://github.com/luost26/academic-homepage" rel="noopener">academic-homepage</a></p>
  </div>
</footer>
