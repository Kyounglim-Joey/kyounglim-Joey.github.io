---
import type { Project } from '../data/content';
interface Props { project: Project; featured?: boolean; headingLevel?: 'h2' | 'h3' }
const { project: p, featured = false, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<article class:list={['card', 'project-card', 'reveal', { featured }]}>
  {featured && <span class="badge">Featured project</span>}
  <H><a href={`/projects/${p.slug}/`} data-loc="project-card">{p.title}</a></H>
  <div class="meta">{p.dates} · {p.role}</div>
  <p>{p.short}</p>
  {featured && (
    <div class="metric-row">
      {p.headline.map((m) => (
        <div class="metric"><div class="value">{m.value}</div><div class="label">{m.label}</div>{m.note && <div class="note">{m.note}</div>}</div>
      ))}
    </div>
  )}
  <ul class="tags" aria-label="Topics">{p.tags.map((t) => <li>{t}</li>)}</ul>
  <span class="more" aria-hidden="true">Read the case study →</span>
</article>
