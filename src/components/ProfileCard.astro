---
/**
 * Sticky profile card for the left column (layout inspired by luost26/academic-homepage, MIT).
 */
import fs from 'node:fs';
import path from 'node:path';
import { SITE, LINKS, PROFILE } from '../config/site';

const hasPhoto = fs.existsSync(path.join(process.cwd(), 'public', PROFILE.photo));
const [emailUser, emailDomain] = LINKS.email.split('@');
---
<div class="card profile-card">
  <div class="portrait">
    {hasPhoto ? (
      <img src={PROFILE.photo} alt={PROFILE.photoAlt} width="600" height="600" decoding="async" fetchpriority="high" />
    ) : (
      <div class="monogram" role="img" aria-label={PROFILE.photoAlt}>KC</div>
    )}
  </div>
  <p class="p-name">{SITE.name}</p>
  {PROFILE.nativeName && <p class="p-native" lang="ko">{PROFILE.nativeName}</p>}
  <p class="p-pos">{PROFILE.positions.map((p) => <span>{p}</span>)}</p>
  <p class="p-email"><a href={`mailto:${LINKS.email}`} data-loc="sidebar">{emailUser}<wbr />(at){emailDomain}</a></p>
  <ul class="p-links" aria-label="Profiles">
    <li>
      <a href={LINKS.github} rel="noopener" data-loc="sidebar" aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
      </a>
    </li>
    {LINKS.linkedin && (
      <li>
        <a href={LINKS.linkedin} rel="noopener" data-loc="sidebar" aria-label="LinkedIn" title="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
        </a>
      </li>
    )}
    <li>
      <a href={`mailto:${LINKS.email}`} data-loc="sidebar-icon" aria-label="Email" title="Email">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
      </a>
    </li>
    <li>
      <a href={LINKS.cv} data-loc="sidebar" aria-label="CV (PDF)" title="CV (PDF)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>
      </a>
    </li>
  </ul>
</div>
