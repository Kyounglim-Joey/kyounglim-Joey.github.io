---
/**
 * Photo carousel: 3 photos per view on desktop (2 on tablet, 1 on phone), prev/next buttons,
 * swipe/scroll, keyboard arrows. Data comes from scripts/sync-photos.mjs at build time.
 */
type Photo = { sm: string; lg: string; width: number; height: number; caption: string; alt: string };
interface Props { title?: string }
const { title = 'Photos' } = Astro.props;

const mods = import.meta.glob<{ default: Photo[] }>('../data/gallery.generated.json', { eager: true });
const photos: Photo[] = Object.values(mods)[0]?.default ?? [];
---
{photos.length > 0 && (
  <section class="gallery-section" aria-labelledby="gallery-title">
    <h2 id="gallery-title">{title}</h2>
    <div class="gallery" data-gallery role="region" aria-roledescription="carousel" aria-label={title}>
      <div class="g-viewport" tabindex="0" aria-label="Use left and right arrow keys to browse photos">
        <ul class="g-track">
          {photos.map((p, i) => (
            <li aria-roledescription="slide" aria-label={`${i + 1} of ${photos.length}`}>
              <figure>
                <a href={p.lg} target="_blank" rel="noopener" data-track="photo_open" data-loc="gallery">
                  <img src={p.sm} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
                </a>
                {p.caption && <figcaption>{p.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </div>
      {photos.length > 1 && (
        <div class="g-controls">
          <span class="g-status" aria-live="polite"></span>
          <button class="icon-btn" type="button" data-dir="-1" aria-label="Previous photos">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button class="icon-btn" type="button" data-dir="1" aria-label="Next photos">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      )}
    </div>
    <script is:inline src="/js/gallery.js" defer></script>
  </section>
)}
