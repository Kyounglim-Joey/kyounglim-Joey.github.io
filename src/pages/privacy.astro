  <section aria-labelledby="who">
    <h2 id="who">Retention and contact</h2>
    <p>Aggregate statistics are kept by Umami for the retention period of the account plan. Questions: <a href={`mailto:${LINKS.email}`}>{LINKS.email}</a>.</p>
  </section>

  <script is:inline src="/js/privacy.js" defer></script>
</Base>
