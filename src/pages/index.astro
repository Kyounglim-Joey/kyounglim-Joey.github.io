---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import Gallery from '../components/Gallery.astro';
import { LINKS } from '../config/site';
import { projects, researchInterests, experience, experienceHighlights, degrees, news } from '../data/content';
const hana = experience[0];
const sundo = experience[1];
const [sejong, ewha] = degrees;
const ordered = [...projects.filter((p) => p.featured), ...projects.filter((p) => !p.featured)];
---
<Base sheet={false} profileOnMobile>
  <section class="card box bio" aria-labelledby="about-title">
    <h1 id="about-title" class="box-title" style="font-size:1.6rem">About Me</h1>
    <p>
      I am an information security engineer at Hana Bank in Seoul. Since 2023 I have worked on the bank’s
      data-encryption and employee-authentication services: HSM/KMS key management, MFA and SSO, and the
      Linux/Unix and network troubleshooting that keeps them running.
    </p>
    <p>
      I came to security from data. After studying philosophy and life sciences at Ewha Womans University,
      I completed an intensive machine learning program where I led three team projects, including fine-tuning
      a Korean T5 model for summarization. I am now finishing a second bachelor’s program in information
      security at Sejong Cyber University.
    </p>
    <p>
      I am applying to master’s programs in computer science and security for Fall 2027. I am mainly interested
      in the security of machine learning systems, applied cryptography, and authentication.
      Email is the quickest way to reach me, and <a href="/cv/" data-loc="home-cta">my CV</a> has the full record.
    </p>
    <div class="quick">
      <a href={LINKS.cv} data-loc="hero"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>CV (PDF)</a>
      <a href={`mailto:${LINKS.email}`} data-loc="home-cta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>Email</a>
      <a href={LINKS.github} rel="noopener" data-loc="hero"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m8 9-4 3 4 3M16 9l4 3-4 3"/></svg>GitHub</a>
    </div>
    <Gallery title="Photos" compact inline moreHref="/about/#gallery-title" />
  </section>

  <section class="card box" aria-label="Education and honors">
    <div class="cols">
      <div>
        <h2 class="box-title" style="font-size:1rem">Education</h2>
        <ul class="rows">
          <li>
            <div class="what">{sejong.school}<span>Information Security, bachelor’s program</span><em class="tag">Studying</em></div>
            <div class="when">Expected Aug 2027</div>
          </li>
          <li>
            <div class="what">{ewha.school}<span>{ewha.degree}</span><em class="tag">Graduated</em></div>
            <div class="when">Feb 2022</div>
          </li>
        </ul>
      </div>
      <div>
        <h2 class="box-title" style="font-size:1rem">Honors &amp; Awards</h2>
        <ul class="rows">
          <li><div class="what">Top Excellence Award<span>AI service competition using a Korean book corpus</span></div><div class="when">2021</div></li>
          <li><div class="what">First place, three times<span>Internal innovation competitions, Hana Bank</span></div><div class="when">2023–24</div></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="card box" aria-labelledby="xp-title">
    <h2 id="xp-title" class="box-title">Experience</h2>
    <div class="xp-line"><strong>{hana.org}</strong><span class="when">{hana.dates}</span></div>
    <p class="xp-role">{hana.title}, {hana.unit}</p>
    <ul class="xp-list">
      {experienceHighlights.map((t) => <li>{t}</li>)}
    </ul>
    <div class="xp-foot">
      <span>Before: {sundo.org}, {sundo.title} ({sundo.dates})</span>
      <a href="/experience/" data-loc="home-experience">More details</a>
    </div>
  </section>

  <section class="card box" aria-labelledby="news-title">
    <h2 id="news-title" class="box-title">News</h2>
    <ul class="news">
      {news.map((n) => <li><span class="d">{n.date}</span><span>{n.text}</span></li>)}
    </ul>
  </section>

  <section class="card box" aria-labelledby="ri-title" data-track-view="research_interests">
    <h2 id="ri-title" class="box-title">Research Interests</h2>
    <ul style="margin:0">
      {researchInterests.map((r) => <li><strong>{r.title}</strong>: {r.text}</li>)}
    </ul>
  </section>

  <section class="card box" aria-labelledby="proj-title">
    <h2 id="proj-title" class="box-title">Selected Projects <small class="muted">team projects, 2021</small></h2>
    <ProjectList items={ordered} />
  </section>
</Base>
