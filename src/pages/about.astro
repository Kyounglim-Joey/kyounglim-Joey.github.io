---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { researchInterests } from '../data/content';
const steps = [
  {
    when: '2015 – 2022',
    title: 'Philosophy and Life Sciences, Ewha Womans University',
    text: 'Philosophy taught me to read an argument for its assumptions and to look for the case where it stops holding. Life Sciences added experiments and data. I still approach a security problem the same way.',
  },
  {
    when: '2021 – 2022',
    title: 'Machine learning and data analysis',
    text: 'In a six-month machine learning program I led three team projects: Korean summarization with a fine-tuned T5 model, mold detection with YOLOv5, and customer-decline prediction. I then worked as a data analyst, preparing training images for a computer-vision model.',
  },
  {
    when: '2023 – now',
    title: 'Information security engineer, Hana Bank',
    text: 'I work on the bank’s encryption and authentication services. Much of the job is finding out why something failed: a race condition in a key-generation library, a proxy dropping CORS preflight requests, a switch fault that first looked like an application bug.',
  },
  {
    when: '2025 – now',
    title: 'Information Security, Sejong Cyber University',
    text: 'I went back to school part-time to study the foundations behind my work, and took linear algebra and probability & statistics for credit. In 2025 I also completed KISA’s K-Shield incident-response program.',
  },
];
---
<Base title="About" description="Background of Kyounglim Cho: philosophy, machine learning, and security engineering in banking.">
  <header>
    <h1>About</h1>
    <p>A longer version of my background and why I am applying to graduate school.</p>
  </header>

  <section aria-labelledby="bg">
    <h2 id="bg">Background</h2>
    <ul class="dated">
      {steps.map((s) => (
        <li><span class="d">{s.when}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="why">
    <h2 id="why">Why graduate school</h2>
    <p>
      Working in a bank has shown me how security controls behave in production, under audit, and when they fail.
      What I lack is the theory and research training to go from a single incident to a general method.
      Banks are now putting machine learning and LLM-based systems into the same regulated environments I work in,
      and I would like to study how those systems can be attacked and how to give them guarantees as clear as those
      we expect from a cryptographic module.
    </p>
    <p>
      I do not have publications yet. The projects on this site are the best record of how I work on a technical problem.
    </p>
  </section>

  <section aria-labelledby="ri-title" data-track-view="research_interests">
    <h2 id="ri-title">Research interests</h2>
    <ul>
      {researchInterests.map((r) => <li><strong>{r.title}</strong>: {r.text}</li>)}
    </ul>
  </section>

  <Gallery title="Photos" />
</Base>
