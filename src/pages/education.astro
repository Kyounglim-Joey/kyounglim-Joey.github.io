---
import Base from '../layouts/Base.astro';
import { degrees, creditCoursework, training } from '../data/content';
---
<Base sheet={false} title="Education" description="Degrees, credit-bearing coursework, and non-degree security and machine learning training.">
  <header class="card box page-intro">
    <h1>Education &amp; Training</h1>
    <p>Degrees, credit-bearing coursework, and non-degree training are listed separately. Certifications are on the <a href="/skills/">Skills</a> page.</p>
  </header>

  <section class="card box" aria-labelledby="deg">
    <h2 id="deg" class="box-title">Degree programs</h2>
    {degrees.map((d) => (
      <article class="entry">
        <div class="head">
          <h3>{d.school}</h3>
          <p class="sub">{d.degree} · {d.place}</p>
        </div>
        <div class="dates">{d.dates}</div>
        <div class="body">
          {d.coursework.length > 0 && (
            <p style="margin:0"><em>Relevant coursework:</em> {d.coursework.join('; ')}</p>
          )}
        </div>
      </article>
    ))}
  </section>

  <section class="card box" aria-labelledby="credit">
    <h2 id="credit" class="box-title">Additional quantitative coursework</h2>
    <p><strong>{creditCoursework.courses.join('; ')}</strong></p>
    <p class="muted" style="margin:0">{creditCoursework.label}. Korea’s Academic Credit Bank System grants accredited university-level credits outside a degree program.</p>
  </section>

  <section class="card box" aria-labelledby="train">
    <h2 id="train" class="box-title">Non-degree training</h2>
    {training.map((t) => (
      <article class="entry">
        <div class="head"><h3>{t.name}</h3><p class="sub">{t.org}</p></div>
        <div class="dates">{t.dates}</div>
        <div class="body"><ul style="margin-bottom:0">{t.topics.map((x) => <li>{x}</li>)}</ul></div>
      </article>
    ))}
  </section>
</Base>
