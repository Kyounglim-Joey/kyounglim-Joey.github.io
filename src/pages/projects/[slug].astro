---
import Base from '../../layouts/Base.astro';
import { projects, type Project } from '../../data/content';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
interface Props { p: Project }
const { p } = Astro.props;
const idx = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(idx + 1) % projects.length];

const toc = [
  ['problem', 'Problem'],
  ['approach', 'Approach'],
  ['stack', 'Tools'],
  ['contributions', 'My contributions'],
  ['methodology', 'Method'],
  ['results', 'Results'],
  ['challenges', 'Challenges'],
  ['lessons', 'What I learned'],
];
const bestRow = (row: string[]) => p.table && p.table.head.length > 2 && row[0] === 'Random Forest';
---
<Base title={p.title} description={p.short} project={p.name} ogType="article">
  <nav class="crumb" aria-label="Breadcrumb"><a href="/projects/">Projects</a> / <span aria-current="page">{p.title}</span></nav>
  <header>
    <h1>{p.title}</h1>
    <p>{p.short}</p>
    <dl class="kv facts">
      <dt>When</dt><dd>{p.dates}</dd>
      <dt>Role</dt><dd>{p.role}</dd>
      <dt>Team</dt><dd>{p.team}</dd>
      <dt>Result</dt><dd>{p.headline.slice(0, 2).map((m) => `${m.label}: ${m.value}`).join('; ')}</dd>
      <dt>Code</dt><dd><a href={p.repo} rel="noopener" data-project={p.name} data-loc="detail-header">{p.repo.replace('https://', '')}</a></dd>
    </dl>
  </header>

  <div class="detail-grid">
    <article class="detail">
      <section id="problem" aria-labelledby="h-problem">
        <h2 id="h-problem">Problem</h2>
        <p>{p.problem}</p>
      </section>

      <section id="approach" aria-labelledby="h-approach">
        <h2 id="h-approach">Approach</h2>
        <ul>{p.approach.map((a) => <li>{a}</li>)}</ul>
      </section>

      <section id="stack" aria-labelledby="h-stack">
        <h2 id="h-stack">Tools</h2>
        <dl class="kv">
          {p.stack.map((s) => (<><dt>{s.group}</dt><dd>{s.items.join(', ')}</dd></>))}
        </dl>
      </section>

      <section id="contributions" aria-labelledby="h-contrib">
        <h2 id="h-contrib">My contributions</h2>
        <ul>{p.contributions.map((c) => <li>{c}</li>)}</ul>
        <p class="muted" style="margin-bottom:.3rem">Done together with the team:</p>
        <ul>{p.teamOutcomes.map((c) => <li>{c}</li>)}</ul>
      </section>

      <section id="methodology" aria-labelledby="h-method">
        <h2 id="h-method">Method</h2>
        <dl class="kv">
          {p.methodology.map((m) => (<><dt>{m.step}</dt><dd>{m.detail}</dd></>))}
        </dl>
      </section>

      <section id="results" aria-labelledby="h-results">
        <h2 id="h-results">Results</h2>
        <ul>{p.results.map((r) => <li>{r}</li>)}</ul>
        {p.table && (
          <div class="table-wrap">
            <table>
              <caption>{p.table.caption}</caption>
              <thead><tr>{p.table.head.map((h, i) => <th scope="col" class={i > 0 ? 'num' : undefined}>{h}</th>)}</tr></thead>
              <tbody>
                {p.table.rows.map((row) => (
                  <tr class={bestRow(row) ? 'best' : undefined}>{row.map((c, i) => (i === 0 ? <th scope="row">{c}</th> : <td class="num">{c}</td>))}</tr>
                ))}
              </tbody>
            </table>
            {p.table.note && <p class="muted"><small>{p.table.note}</small></p>}
          </div>
        )}
        {p.figures?.map((f) => (
          <figure>
            <img src={f.src} alt={f.alt} width={f.width} height={f.height} loading="lazy" decoding="async" />
            <figcaption>{f.caption}</figcaption>
          </figure>
        ))}
      </section>

      <section id="challenges" aria-labelledby="h-chal">
        <h2 id="h-chal">Challenges</h2>
        <ul>{p.challenges.map((c) => <li>{c}</li>)}</ul>
      </section>

      <section id="lessons" aria-labelledby="h-lessons">
        <h2 id="h-lessons">What I learned</h2>
        <ul>{p.lessons.map((l) => <li>{l}</li>)}</ul>
        <p>{p.connection}</p>
      </section>

      <hr />
      <p style="font-size:.95rem">
        Source code: <a href={p.repo} rel="noopener" data-project={p.name} data-loc="detail-repo">{p.repo.replace('https://', '')}</a>
        <span class="muted"> (team repository; notebooks are mostly in Korean)</span><br />
        Next: <a href={`/projects/${next.slug}/`} data-loc="next-project">{next.title}</a>
      </p>
    </article>

    <aside class="toc" aria-label="On this page">
      <p>Contents</p>
      <ol>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
    </aside>
  </div>
</Base>
