---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import { projects } from '../../data/content';
const ordered = [...projects.filter((p) => p.featured), ...projects.filter((p) => !p.featured)];
---
<Base title="Projects" description="Machine learning projects: Korean summarization with ET5, YOLOv5 mold detection, and customer-decline prediction.">
  <header>
    <h1>Projects</h1>
    <p>Three team projects from an intensive machine learning program in 2021. I led all three teams. Each page separates what I did from what the team did.</p>
  </header>
  <ProjectList items={ordered} level="h2" />
</Base>
