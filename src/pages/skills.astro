---
import Base from '../layouts/Base.astro';
import { skills, certifications, languages } from '../data/content';
---
<Base sheet={false} title="Skills & Certifications" description="Technical skills grouped by area, with where each was used, plus certifications and languages.">
  <header class="card box page-intro">
    <h1>Skills &amp; Certifications</h1>
    <p>Grouped by area, with where I used each one.</p>
  </header>

  <section class="card box" aria-labelledby="sk">
    <h2 id="sk" class="box-title">Technical skills</h2>
    <dl class="kv">
      {skills.map((s) => (<><dt>{s.group}</dt><dd>{s.items.join(', ')}<br /><small class="muted">Used in: {s.evidence}</small></dd></>))}
    </dl>
  </section>

  <section class="card box" aria-labelledby="cert">
    <h2 id="cert" class="box-title">Professional certifications</h2>
    <div class="table-wrap">
      <table style="margin:0">
        <thead><tr><th scope="col">Certification</th><th scope="col">Issuer</th><th scope="col">Date</th></tr></thead>
        <tbody>
          {certifications.map((c) => (
            <tr><th scope="row">{c.name}</th><td>{c.issuer}</td><td>{c.date || '—'}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="card box" aria-labelledby="lang">
    <h2 id="lang" class="box-title">Languages</h2>
    <dl class="kv">{languages.map((l) => (<><dt>{l.name}</dt><dd>{l.level}</dd></>))}</dl>
  </section>
</Base>
