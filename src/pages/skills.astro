---
import Base from '../layouts/Base.astro';
import { skills, certifications, languages } from '../data/content';
---
<Base title="Skills & Certifications" description="Technical skills grouped by area, with where each was used, plus certifications and languages.">
  <header class="page-head">
    <p class="eyebrow">Skills &amp; certifications</p>
    <h1>Skills &amp; certifications</h1>
    <p>Grouped by area, with where each was used. No self-rated proficiency scores — the evidence is in the experience and project pages.</p>
  </header>

  <section aria-labelledby="sk">
    <h2 id="sk" class="visually-hidden">Technical skills</h2>
    <div class="grid two">
      {skills.map((s) => (
        <div class="card reveal">
          <h3 style="font-family:var(--font-sans);font-size:1.05rem">{s.group}</h3>
          <ul class="tags" style="margin-bottom:.8rem">{s.items.map((i) => <li>{i}</li>)}</ul>
          <p class="muted" style="margin:0;font-size:.88rem">Used in: {s.evidence}</p>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="cert">
    <h2 id="cert">Professional certifications</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Certification</th><th scope="col">Issuer</th><th scope="col">Date</th></tr></thead>
        <tbody>
          {certifications.map((c) => (
            <tr><th scope="row">{c.name}</th><td>{c.issuer}</td><td>{c.date || '—'}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="lang">
    <h2 id="lang">Languages</h2>
    <dl class="kv">{languages.map((l) => (<><dt>{l.name}</dt><dd>{l.level}</dd></>))}</dl>
  </section>
</Base>
