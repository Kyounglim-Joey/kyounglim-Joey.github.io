---
import Base from '../layouts/Base.astro';
import { experience } from '../data/content';
---
<Base sheet={false} title="Experience" description="Security engineering in banking (cryptography, HSM/KMS, MFA, Linux/Unix, network troubleshooting) and data analytics experience.">
  <header class="card box page-intro">
    <h1>Experience</h1>
    <p>What I worked on and what I fixed. Internal details of my employer’s systems are left out.</p>
  </header>

  {experience.map((job) => (
    <section class="card box" aria-label={job.org}>
      <div class="card-head">
        <h2 class="box-title">{job.org}</h2>
        <span class="dates">{job.dates}</span>
      </div>
      <p class="card-sub">{job.title} · {job.unit} · {job.place}</p>
      <p>{job.summary}</p>
      {job.groups.map((g) => (
        <div>
          <h3 class="group-title">{g.area}</h3>
          <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </section>
  ))}

  <p class="muted" style="margin:1rem .25rem 0"><small>For confidentiality, system names, network layout, server counts, vendor products, and access policies are not disclosed.</small></p>
</Base>
