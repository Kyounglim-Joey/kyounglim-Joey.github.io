---
import '@fontsource/lato/latin-400.css';
import '@fontsource/lato/latin-400-italic.css';
import '@fontsource/lato/latin-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { SITE, LINKS } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  project?: string; // analytics identifier for project detail pages
  ogType?: 'website' | 'article';
  /** Wrap page content in a white card (default). The home page composes its own cards. */
  sheet?: boolean;
  /** Show the profile card on small screens too (home page only by default). */
  profileOnMobile?: boolean;
}

const { title, description = SITE.description, project, ogType = 'website', sheet = true, profileOnMobile = false } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/og.png', SITE.url).href;

const sameAs = [LINKS.github, LINKS.linkedin].filter(Boolean);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role,
  url: SITE.url,
  sameAs,
  knowsAbout: ['Applied cryptography', 'Key management', 'Authentication', 'Machine learning', 'AI security'],
};

const csp = [
  "default-src 'self'",
  "script-src 'self' https://cloud.umami.is",
  "connect-src 'self' https://gateway.umami.is https://cloud.umami.is https://api-gateway.umami.dev",
  "img-src 'self' data:",
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f9fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121417" media="(prefers-color-scheme: dark)" />
    <meta name="author" content={SITE.name} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline src="/js/theme-init.js"></script>
  </head>
  <body data-project={project}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <div class="wrap layout">
        <aside class:list={['sidebar', { 'mobile-hidden': !profileOnMobile }]} aria-label="Profile">
          <ProfileCard />
        </aside>
        <div class:list={['main-col', { sheet }]}>
          <slot />
        </div>
      </div>
    </main>
    <Footer />
    <script is:inline src="/js/site.js" defer></script>
    <Analytics />
  </body>
</html>
